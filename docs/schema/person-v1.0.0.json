{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "local://iroko/person-v1.1.0.json",
  "title": "Person Schema (ORCID-enriched)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "identifiers",
    "iroko_uuid",
    "name"
  ],
  "properties": {

    "iroko_uuid": {
      "type": "string",
      "description": "Iroko UUID, pid_type = perid"
    },

    "identifiers": {
      "type": "array",
      "description": "Person Identifiers, including researcher profiles",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["idtype", "value"],
        "properties": {
          "idtype": {
            "type": "string",
            "description": "Identifier type (e.g., orcid, scopus-id, profile-url)"
          },
          "value": {
            "type": "string"
          },
          "relationship": {
            "type": "string",
            "description": "ORCID relationship (self / part-of / version-of)",
            "enum": ["self", "part-of", "version-of"]
          }
        }
      }
    },

    "name": {
      "type": "string",
      "description": "Full name of the person"
    },

    "given_name": {
      "type": "string"
    },

    "family_name": {
      "type": "string"
    },

    "biography": {
      "type": "string"
    },

    "public": {
      "type": "boolean",
      "description": "Whether the ORCID profile is public"
    },

    "gender": {
      "type": "string"
    },

    "country": {
      "type": "object",
      "description": "Primary residence country",
      "properties": {
        "code": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 code"
        },
        "name": {
          "type": "string"
        }
      }
    },

    "addresses": {
      "type": "array",
      "description": "List of postal addresses",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "city": { "type": "string" },
          "region": { "type": "string" },
          "country": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2 code"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    },

    "email_addresses": {
      "type": "array",
      "items": { "type": "string" }
    },

    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },

    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },

    "affiliations": {
      "description": "Relationships between the person and any organization",
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {

          "identifiers": {
            "type": "array",
            "description": "Organization identifiers",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["idtype", "value"],
              "properties": {
                "idtype": { "type": "string" },
                "value": { "type": "string" },
                "relationship": {
                  "type": "string",
                  "enum": ["self", "part-of", "version-of"]
                }
              }
            }
          },
          "country": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Start date of the affiliation"
          },

          "end_date": {
            "type": "string",
            "format": "date",
            "description": "End date of the affiliation"
          },

          "name": {
            "type": "string",
            "description": "Name of the related organization"
          },
          "department_name": {
            "type": "string",
            "description": "Name of the department within the related organization"
          },
          "roles": {
            "type": "array",
            "items": { "type": "string" }
          },

          "affiliation_type": {
            "type": "string",
            "description": "ORCID activity type",
            "enum": [
              "employments",
              "educations",
              "qualifications",
              "invited-positions",
              "distinctions",
              "memberships",
              "services",
              "fundings"
            ]
          }
        }
      }
    },

    "peer-review": {
      "description": "Peer-review relationships between the person and publications",
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {

          "identifiers": {
            "type": "array",
            "description": "Publication identifiers",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["idtype", "value"],
              "properties": {
                "idtype": { "type": "string" },
                "value": { "type": "string" },
                "relationship": {
                  "type": "string",
                  "enum": ["self", "part-of", "version-of"]
                }
              }
            }
          },

          "start_date": {
            "type": "string",
            "format": "date"
          },

          "end_date": {
            "type": "string",
            "format": "date"
          },

          "organization": {
            "type": "object",
            "description": "convening organization",
            "items": {
              "name": {
                "type": "string"
              },
              "identifiers": {
                "type": "array",
                "description": "Publication identifiers",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["idtype", "value"],
                  "properties": {
                    "idtype": { "type": "string" },
                    "value": { "type": "string" },
                    "relationship": {
                      "type": "string",
                      "enum": ["self", "part-of", "version-of"]
                    }
                  }
                }
              }
            }
          },
          "roles": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
