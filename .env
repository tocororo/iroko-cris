ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=System Administrator

# CORS (comma-separated)
CORS_ORIGINS=["http://localhost:8000","http://localhost:4200","https://localhost:4200","https://localhost:8334"]

LOG_TO_FILE=true
LOG_FILE_PATH=iroko.log
LOG_LEVEL=DEBUG
CONTAINER_ENV=true
JSON_LOGS=false 
