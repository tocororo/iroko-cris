<http://sceiba.cu/id/0350d35a-e3bc-43e6-aec5-52b401888297> a sceiba:Source ;
    sceiba:Classification <http://sceiba.cu/id/0350d35a-e3bc-43e6-aec5-52b401888297/classifications> ;
