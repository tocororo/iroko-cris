    identifier:url <https://revistas.udg.co.cu/index.php/roca/announcement/view/8> .

<http://sceiba.cu/id/2782b8c4-b57b-4148-ade4-9b4dd047f980> a sceiba:Source ;
    sceiba:Classification <http://sceiba.cu/id/2782b8c4-b57b-4148-ade4-9b4dd047f980/classifications> ;
    sceiba:affiliatedTo "N689bf3d907ee435ab93392a50ae6eb92",
        "Ncc6d58a2fd7548c185c7011c21d3d987" ;
    sceiba:aliases <http://sceiba.cu/id/2782b8c4-b57b-4148-ade4-9b4dd047f980/aliases> ;
    sceiba:description """<p>Ciencias de la Información es una publicación científica, en formato digital e impreso. Editada por el Instituto de Información Científica y Tecnológica (IDICT) en coordinación con la Sociedad Cubana de Ciencias de la Información (SOCICT). Tiene una periodicidad cuatrimestral y está diseñada para publicar los resultados de investigación de todos los profesionales vinculados a la industria de la Información y el conocimiento. Cubre todos los aspectos esenciales de la Bibliotecología, la Documentación y Archivología y acepta contribuciones en cualesquiera de las siguientes temáticas:</p>\r
\r
<ol>\r
	<li>Sistemas de información</li>\r
	<li>Representación y organización de la información</li>\r
	<li>Gestión de la información y el conocimiento</li>\r
	<li>Gestión de organizaciones de información</li>\r
	<li>Tecnologías de la información y las comunicaciones</li>\r
	<li>Teoría de la Ciencia de la Información</li>\r
	<li>Alfabetización informacional</li>\r
	<li>Análisis de información</li>\r
	<li>Sociedad de la información</li>\r
</ol>\r
""" ;
    sceiba:id "2782b8c4-b57b-4148-ade4-9b4dd047f980" ;
    sceiba:logo "pageHeaderTitleImage_es_ES_0.jpg" ;
