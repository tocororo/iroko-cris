<http://sceiba.cu/id/179af5c8-d2d1-4d84-af5c-62b659a52bc0> a sceiba:Source ;
    sceiba:Classification <http://sceiba.cu/id/179af5c8-d2d1-4d84-af5c-62b659a52bc0/classifications> ;
    sceiba:affiliatedTo "N3432f6f162254c8ba098d9efc1f92658",
        "N7930901956bf46189caedf2f25122e00" ;
    sceiba:aliases <http://sceiba.cu/id/179af5c8-d2d1-4d84-af5c-62b659a52bc0/aliases> ;
    sceiba:description "Es una publicación en formato electrónico con el propósito de contribuir a la comunicación entre los profesionales de la Ingeniería. Se concibe como un foro en el que se presentan artículos científicos-técnicos en las variadas áreas de la ingeniería, con un destaque de resultados novedosos y aportes de relevancia para la profesión. De esta manera, la revista se propone contribuir a la actualización de profesionales, investigadores, profesores y estudiantes de ingeniería, a la discusión científica nacional e internacional y, por consiguiente, al desarrollo tecnológico y científico de Cuba en el área de la ingeniería." ;
    sceiba:frequency "cuatrimestral" ;
    sceiba:id "179af5c8-d2d1-4d84-af5c-62b659a52bc0" ;
    sceiba:logo "RCI.JPG" ;
    sceiba:name "Revista cubana de ingeniería" ;
    sceiba:repositoryStatus "RECORDED" ;
    sceiba:sourceStatus "APPROVED" ;
    sceiba:title "Revista cubana de ingeniería" ;
    sceiba:url "http://rci.cujae.edu.cu/index.php/rci" ;
    identifier:issn_e "2223-1781" ;
