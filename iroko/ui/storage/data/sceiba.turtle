<http://sceiba.cu/id/0f7745dd-dabf-4cbd-a615-49c65cc37665> a sceiba:Source ;
    sceiba:Classification <http://sceiba.cu/id/0f7745dd-dabf-4cbd-a615-49c65cc37665/classifications> ;
    sceiba:affiliatedTo "N331187d488ae4050bdcb21ba11971f8c",
        "N96110d1ca99d4c69bce034ef67b54312" ;
    sceiba:aliases <http://sceiba.cu/id/0f7745dd-dabf-4cbd-a615-49c65cc37665/aliases> ;
    sceiba:description "<p>Revista cubano- turca de estudios latinoamericanos. Una publicación anual de la <a href=\"http://www.flacso.uh.cu/\">Facultad Latinoamericana de Ciencias Sociales, Programa Cuba</a>, y del <a href=\"http://cel.ankara.edu.tr/?page_id=198\">Centro de Estudios Latinoamericanos de la Universidad de Ankara, Turquía</a>.</p><p>Aborda temas relacionados con los estudios sociales en América Laina. Su misión es divulgar los resultados de invesigación de los profesores de ambos centros así como de otros académicos y colaboradores.</p><p>Sobre Cuadernos Turquinos, otros enlaces:</p><p><a href=\"https://www.facebook.com/estudios.turcos/posts/708143399277234\">Seguir en <em>Facebook</em></a></p><p><em><a href=\"http://cel.ankara.edu.tr/?page_id=222\">Acerca de los primeros números</a></em></p>" ;
    sceiba:id "0f7745dd-dabf-4cbd-a615-49c65cc37665" ;
    sceiba:name "Cuadernos turquinos." ;
    sceiba:sourceStatus "UNOFFICIAL" ;
    sceiba:title "Cuadernos turquinos." ;
    identifier:issn_l "2304-3245" ;
    identifier:issn_p "2304-3245" ;
    identifier:prnps "0610" .

