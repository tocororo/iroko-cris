<http://sceiba.cu/id/277d3cc2-8480-4098-a78d-d300ebaec9e1> a sceiba:Source ;
    sceiba:Classification <http://sceiba.cu/id/277d3cc2-8480-4098-a78d-d300ebaec9e1/classifications> ;
    sceiba:affiliatedTo "Nd793b9d654f943079f469c74e0dcec06" ;
    sceiba:aliases <http://sceiba.cu/id/277d3cc2-8480-4098-a78d-d300ebaec9e1/aliases> ;
    sceiba:description "Publicación de carácter científico-educacional encargada de promover los resultados más relevantes de los profesionales de la educación en la provincia de Granma, Cuba y Latinoamérica. La revista Roca se edita en el Centro de Recursos para el Aprendizaje y la Investigación (CRAI), perteneciente a la Universidad de Granma, mediante el sistema de Publicación Continua. Aborda un perfil temático especializado en las diferentes líneas de la investigación científica educacional. Publica trabajos relacionados con Pedagogía, Psicología educacional, Filosofía educacional, Sociología educacional, Socioculturales y de la enseñanza de idiomas extranjeros." ;
    sceiba:id "277d3cc2-8480-4098-a78d-d300ebaec9e1" ;
    sceiba:name "Roca." ;
    sceiba:sourceStatus "APPROVED" ;
    sceiba:sourceSystem "OJS" ;
    sceiba:startYear "2019-01-01T05:00:00.000Z" ;
    sceiba:title "Roca" ;
    sceiba:url "https://revistas.udg.co.cu/index.php/roca/announcement/view/8" ;
